<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_item_bg"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Checkbox / Complete Task Button -->
        <ImageView
            android:id="@+id/widget_item_check"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_widget_check_circle"
            android:contentDescription="Complete Task"
            android:clickable="true" />

        <!-- Title -->
        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Task Title"
            android:textColor="#E6EDF3"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Priority Badge -->
        <TextView
            android:id="@+id/widget_item_priority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HIGH"
            android:textColor="#F87171"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginStart="4dp" />

        <!-- Expand / Collapse chevron indicator -->
        <ImageView
            android:id="@+id/widget_item_chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_chevron"
            android:layout_marginStart="2dp"
            android:padding="2dp"
            android:contentDescription="Expand" />
    </LinearLayout>

    <!-- Subtitle: Space › Subspace • Due • List -->
    <TextView
        android:id="@+id/widget_item_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="2dp"
        android:text="Work › Dev • Due Tomorrow"
        android:textColor="#8B949E"
        android:textSize="10.5sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Expandable Notes / Description snippet -->
    <TextView
        android:id="@+id/widget_item_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="3dp"
        android:textColor="#94A3B8"
        android:textSize="10.5sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>

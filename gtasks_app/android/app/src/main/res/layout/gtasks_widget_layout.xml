<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="GTasks" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GTasks"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All caught up"
                android:textColor="#9EABB8"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_btn_view_mode"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_view_detailed"
            android:contentDescription="Switch View (Detailed, Compact, 2-Column)"
            android:clickable="true"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/widget_btn_sync"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_sync"
            android:contentDescription="Quick Sync"
            android:clickable="true"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh"
            android:clickable="true"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/widget_btn_ai"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_ai"
            android:contentDescription="AI Assistant"
            android:clickable="true"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/widget_btn_add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="Add Task"
            android:clickable="true"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Interactive Tab Navigation Strip (Next / Prev tabs with independent filters) -->
    <LinearLayout
        android:id="@+id/widget_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_btn_tab_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_chevron_left"
            android:contentDescription="Previous Tab"
            android:clickable="true"
            android:padding="5dp" />

        <LinearLayout
            android:id="@+id/widget_btn_tab_center"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_filter_pill_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clickable="true">

            <TextView
                android:id="@+id/widget_tab_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦ All Tasks"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_tab_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="(1/4)"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_btn_tab_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_chevron_right"
            android:contentDescription="Next Tab"
            android:clickable="true"
            android:padding="5dp" />
    </LinearLayout>

    <!-- Filter Icons Strip -->
    <LinearLayout
        android:id="@+id/widget_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/widget_filter_list"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_list"
            android:contentDescription="Filter by List"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_tag"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_tag"
            android:contentDescription="Filter by Tag"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_space"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_space"
            android:contentDescription="Filter by Workspace"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_subspace"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_subspace"
            android:contentDescription="Filter by Sub-workspace"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_account"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_account"
            android:contentDescription="Filter by Account"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_date"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_calendar"
            android:contentDescription="Filter by Date Window"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_recurring"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_recurring"
            android:contentDescription="Recurring Tasks Filter"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_sort"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_sort"
            android:contentDescription="Sort by"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_hide"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_visibility_off"
            android:contentDescription="Hide &amp; Exclusions"
            android:clickable="true"
            android:padding="5dp" />
    </LinearLayout>

    <!-- Active Filter Badge Pill (Visible when a filter, exclusion, or sort is applied) -->
    <LinearLayout
        android:id="@+id/widget_active_filter_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_filter_pill_bg"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_active_filter_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Space: Work"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/widget_btn_clear_filter"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_close"
            android:contentDescription="Clear Filter"
            android:clickable="true"
            android:padding="3dp" />
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@drawable/widget_divider"
        android:layout_marginBottom="6dp"
        android:contentDescription="Divider" />

    <!-- Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Single Rock-Solid Task ListView (Handles Detailed, Compact One-Liner, and 2-Column Rows) -->
        <ListView
            android:id="@+id/widget_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="3dp" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/widget_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No pending tasks 🎉"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap + to create a task"
                android:textColor="#7C8BA1"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

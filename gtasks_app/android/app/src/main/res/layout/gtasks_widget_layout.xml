<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="GTasks" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GTasks"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All caught up"
                android:textColor="#9EABB8"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_btn_sync"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_sync"
            android:contentDescription="Quick Sync"
            android:clickable="true"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh"
            android:clickable="true"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/widget_btn_add"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="Add Task"
            android:clickable="true"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Filter Icons Strip -->
    <LinearLayout
        android:id="@+id/widget_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_filter_list"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_list"
            android:contentDescription="Filter by List"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_tag"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_tag"
            android:contentDescription="Filter by Tag"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_space"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_space"
            android:contentDescription="Filter by Workspace"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_subspace"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_subspace"
            android:contentDescription="Filter by Sub-workspace"
            android:clickable="true"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/widget_filter_account"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_bg"
            android:src="@drawable/ic_widget_account"
            android:contentDescription="Filter by Account"
            android:clickable="true"
            android:padding="5dp" />

        <!-- Active Filter Badge Pill (Visible when a filter is applied) -->
        <LinearLayout
            android:id="@+id/widget_active_filter_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_filter_pill_bg"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_active_filter_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Space: Work"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_btn_clear_filter"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_close"
                android:contentDescription="Clear Filter"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@drawable/widget_divider"
        android:layout_marginBottom="6dp"
        android:contentDescription="Divider" />

    <!-- Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Task List -->
        <ListView
            android:id="@+id/widget_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="4dp" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/widget_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No pending tasks 🎉"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap + to create a task"
                android:textColor="#7C8BA1"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

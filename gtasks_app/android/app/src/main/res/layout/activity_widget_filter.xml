<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_rounded_bg"
    android:padding="20dp"
    android:layout_margin="16dp"
    android:maxHeight="480dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/iv_filter_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_space"
            android:contentDescription="Filter" />

        <TextView
            android:id="@+id/tv_filter_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Select Filter"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_filter_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_close"
            android:contentDescription="Close"
            android:clickable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_filter_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- Search input -->
    <EditText
        android:id="@+id/et_filter_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search..."
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:textSize="14sp"
        android:background="#252D3D"
        android:padding="10dp"
        android:inputType="text" />

    <!-- "All / Clear Filter" option -->
    <TextView
        android:id="@+id/tv_filter_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="★ All (Clear Filter)"
        android:textColor="#38BDF8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:clickable="true"
        android:background="?android:attr/selectableItemBackground" />

    <!-- Options List -->
    <ListView
        android:id="@+id/lv_filter_options"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#334155"
        android:dividerHeight="1dp" />

    <!-- Done / Apply Button (for multi-select exclusions) -->
    <Button
        android:id="@+id/btn_filter_done"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Done / Apply"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:background="#2563EB"
        android:layout_marginTop="10dp"
        android:visibility="gone" />
</LinearLayout>

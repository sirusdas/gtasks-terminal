<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_rounded_bg"
    android:padding="16dp"
    android:layout_margin="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_ai"
            android:contentDescription="AI Sparkle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Quick AI Assistant"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_quick_ai_scope"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_filter_pill_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="All Tasks"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/btn_quick_ai_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_close"
            android:contentDescription="Close"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Quick Action Chips Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_chip_urgent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/quick_ai_chip_bg"
                android:text="⚡ Most Urgent"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_chip_earliest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/quick_ai_chip_bg"
                android:text="⏰ Earliest Due"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_chip_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/quick_ai_chip_bg"
                android:text="📊 Summary"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_chip_doneall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/quick_ai_chip_bg"
                android:text="✅ Done All"
                android:textColor="#F472B6"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_chip_full_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/quick_ai_chip_bg"
                android:text="💬 Full Chat ↗"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Result / Response Box -->
    <LinearLayout
        android:id="@+id/ll_quick_ai_result_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#151A23"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_quick_ai_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading view insights..."
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <!-- Task Preview Card (Optional) -->
        <LinearLayout
            android:id="@+id/ll_quick_ai_task_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#252D3D"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_task_check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_unchecked"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_task_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Task Title"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tv_task_priority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIGH"
                        android:textColor="#F97316"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_task_due"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Due Today"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_task_mark_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Bulk Complete Confirmation Box (Optional) -->
        <LinearLayout
            android:id="@+id/ll_quick_ai_confirm_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_confirm_cancel"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Cancel"
                android:textColor="#94A3B8"
                android:background="#252D3D"
                android:textSize="11sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_confirm_yes"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Yes, Complete All"
                android:textColor="#FFFFFF"
                android:background="#10B981"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Input & Send Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_quick_ai_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ask AI or type command..."
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:background="#252D3D"
            android:padding="10dp"
            android:singleLine="true"
            android:imeOptions="actionSend" />

        <Button
            android:id="@+id/btn_quick_ai_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Ask"
            android:textColor="#FFFFFF"
            android:background="#3B82F6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minWidth="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>
</LinearLayout>
